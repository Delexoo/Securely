# Securely — local secrets for this product only.
# Copy to `.env` and fill in. Never commit `.env`.

# Stripe (Securely $3/mo subscription)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PROMO_ID=
SECURELY_PROMO_CODE=SECURELY-DEV

# OpenRouter (server-side analyze proxy)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_VISION_MODEL=

# Optional multi-engine file/URL reputation (VirusTotal API v3 — never put in the desktop app)
VIRUSTOTAL_API_KEY=

# GitHub Releases (Delexoo/Securely)
GITHUB_TOKEN=
GITHUB_OWNER=Delexoo
GITHUB_REPO=Securely

# Vercel production (Securely website project)
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Public site origin used by the desktop app (canonical: trysecurely.com)
SECURELY_SITE_URL=https://trysecurely.com

# Optional shared secret for /api/analyze and /api/analyze-threat (desktop sends X-Securely-Key)
SECURELY_ANALYZE_KEY=

# Optional contact form delivery webhook (POST JSON { name, email, message })
CONTACT_WEBHOOK_URL=
