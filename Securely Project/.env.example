# Server-side only — never ship these in the desktop client or website JS.

# Analyze proxy (Supabase Edge or other HTTPS endpoint)
SECURELY_API_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/analyze
# Optional Bearer for REQUIRE_AUTH=1
SECURELY_API_JWT=

# Edge Function secrets (set in Supabase Dashboard, not in the client)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-8b-instruct
REQUIRE_AUTH=0

# Stripe (server / website API routes only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_BUSINESS=
REQUIRE_STRIPE=0
