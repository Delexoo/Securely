{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://api.stripe.com https://openrouter.ai; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com"
        },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/checkout", "destination": "/api/checkout.js" },
    { "source": "/api/license", "destination": "/api/license.js" },
    { "source": "/api/portal", "destination": "/api/portal.js" },
    { "source": "/api/webhook", "destination": "/api/webhook.js" },
    { "source": "/api/analyze", "destination": "/api/analyze.js" },
    { "source": "/api/latest-download", "destination": "/api/latest-download.js" },
    { "source": "/download/latest", "destination": "/api/latest-download.js" }
  ]
}
